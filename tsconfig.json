{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "allowJs": true,
    "noImplicitThis": false,
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "paths": {
      "react": ["./node_modules/@types/react"]
    }
  }
}
